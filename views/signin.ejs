<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Sign in</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <h1>Sign in</h1>

    <form action="/signin" method="POST" class="post-form">
        <input type="text" name="user_id" placeholder="Username" required>
        <input type="password" name="password" placeholder="Password" required>
        <button type="submit">Sign In</button>
    </form>

    <form action="/signup" method="GET" style="margin-top:10px;">
        <button type="submit">Go to Sign Up</button>
    </form>

    <form action="/" method="GET" style="margin-top:10px;">
        <button type="submit">Back to Home</button>
    </form>
</body>
</html>