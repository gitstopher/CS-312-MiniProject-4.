<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Sign Up</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <h1>Create an Account</h1>
  
  <form action="/signup" method="POST" class="post-form">
    <input type="text" name="user_id" placeholder="Username" required>
    <input type="text" name="name" placeholder="Full Name" required>
    <input type="password" name="password" placeholder="Password" required>
    <button type="submit">Sign Up</button>
  </form>

  <form action="/signin" method="GET" style="margin-top:10px;">
    <button type="submit">Go to Sign In</button>
  </form>

  <form action="/" method="GET" style="margin-top:10px;">
    <button type="submit">Back to Home</button>
  </form>
</body>
</html>